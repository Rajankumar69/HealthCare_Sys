{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Key": "HealthcareSuperSecretKeyForJwtAuthentication2026!Raj",
    "Issuer": "HealthcareAuthService",
    "Audience": "HealthcareApp"
  },
  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "auth-cluster",
        "AuthorizationPolicy": "Anonymous",
        "Order": 1,
        "Match": {
          "Path": "/api/auth/{**catch-all}"
        }
      },
      "healthcare-public-patient-create": {
        "ClusterId": "healthcare-cluster",
        "AuthorizationPolicy": "Anonymous",
        "Order": 2,
        "Match": {
          "Path": "/api/healthcare/patients",
          "Methods": [ "POST" ]
        }
      },
      "healthcare-route": {
        "ClusterId": "healthcare-cluster",
        "AuthorizationPolicy": "RequireJwtToken",
        "Order": 3,
        "Match": {
          "Path": "/api/healthcare/{**catch-all}"
        }
      },
      "ai-route": {
        "ClusterId": "healthcare-cluster",
        "AuthorizationPolicy": "Anonymous",
        "Order": 4,
        "Match": {
          "Path": "/api/ai/{**catch-all}"
        }
      },
      "globalsearch-route": {
        "ClusterId": "globalsearch-cluster",
        "AuthorizationPolicy": "Anonymous",
        "Order": 5,
        "Match": {
          "Path": "/api/globalsearch/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "auth-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5010"
          }
        }
      },
      "healthcare-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5020"
          }
        }
      },
      "globalsearch-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5030"
          }
        }
      }
    }
  }
}
